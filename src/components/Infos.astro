---
// Infos pratiques : horaires (jour courant surligné), adresse, carte au clic, réseaux
import data from '../data/data.json';
import { hFr } from '../lib/horaires.js';
import { liens } from '../lib/liens.js';
import Icone from './Icone.astro';
import { horaires } from '../lib/boutique.js';

const c = data.commerce;
const { itineraire, appel, embed } = liens(c);
const reseaux = Object.entries(c.reseaux).filter(([, url]) => url);
---
<section class="section infos" id="infos" aria-labelledby="titre-infos">
  <div class="conteneur grille">
    <div>
            <h2 id="titre-infos">Quand passer</h2>
      <p class="statut" data-statut></p>
      <table class="horaires">
        <tbody>
          {horaires.map(({ jour, creneaux }) => (
            <tr data-jour={jour} class={creneaux.length ? '' : 'ferme'}>
              <th scope="row">{jour}</th>
              <td>{creneaux.length ? creneaux.map(([a, b]) => <span class="creneau">{hFr(a)} – {hFr(b)}</span>) : 'Fermé'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div>
      <h2>Où nous trouver</h2>
      <address>
        <strong>{c.nom}</strong><br />
        {c.adresse.rue}<br />
        {c.adresse.codePostal} {c.adresse.ville}<br />
        <a href={appel}>{c.telephoneAffiche}</a>
      </address>

      <!-- Carte "façade" : l'iframe Google Maps (~500 Ko) n'est chargée qu'au clic -->
      <div class="carte" data-embed={embed}>
        <button type="button" class="btn" data-charger-carte>
          <Icone nom="carte" />Afficher la carte
        </button>
      </div>

      <a class="btn btn--contour lien-itin" href={itineraire} target="_blank" rel="noopener">
        <Icone nom="itineraire" />Itinéraire Google Maps
      </a>

      {reseaux.length > 0 && (
        <ul class="reseaux">
          {reseaux.map(([nom, url]) => (
            <li><a href={url} target="_blank" rel="noopener" aria-label={`${c.nom} sur ${nom}`}><Icone nom={nom} /></a></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<script is:inline>
  // Chargement de la carte uniquement à la demande (performance)
  document.querySelector('[data-charger-carte]')?.addEventListener('click', (e) => {
    const box = e.currentTarget.parentElement;
    box.innerHTML = `<iframe src="${box.dataset.embed}" title="Plan d'accès" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>`;
  });
</script>

<style>
  .infos { background: var(--torref); color: var(--brume); }
  .infos h2 { color: var(--brume); }
  .grille { display: grid; gap: 56px; }
  .infos .statut { background: #e9ebe61a; margin-top: 18px; }
  .horaires { width: 100%; border-collapse: collapse; margin-top: 18px; }
  .horaires th, .horaires td { padding: 13px 0; border-bottom: 1px solid #e9ebe621; text-align: left; vertical-align: top; }
  .horaires th { text-transform: capitalize; font-weight: 600; width: 40%; }
  .horaires td { text-align: right; font-variant-numeric: tabular-nums; }
  .creneau { display: block; }
  .horaires tr.ferme td { color: #e9ebe680; }
  .horaires tr.aujourdhui { color: var(--t2); }
  .horaires tr.aujourdhui th::after { content: " (aujourd'hui)"; font-weight: 400; font-size: .85em; text-transform: none; }
  address { font-style: normal; margin-top: 18px; font-size: 1.15rem; line-height: 1.55; }
  address a { color: var(--t2); font-weight: 600; text-decoration: none; }
  .carte {
    position: relative; aspect-ratio: 4 / 3; border-radius: 6px; overflow: hidden; margin: 22px 0 12px;
    display: grid; place-items: center; background: var(--baie);
    background-image:
      radial-gradient(circle at 50% 48%, var(--t2) 0 9px, transparent 10px),
      repeating-linear-gradient(0deg, transparent 0 39px, #e9ebe61f 39px 40px),
      repeating-linear-gradient(90deg, transparent 0 39px, #e9ebe61f 39px 40px);
  }
  .carte .btn { background: var(--brume); color: var(--torref); border-color: var(--brume); margin-top: 90px; }
  .carte :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .lien-itin { width: 100%; color: var(--brume); border-color: var(--brume); }
  .reseaux { list-style: none; padding: 0; margin: 24px 0 0; display: flex; gap: 12px; }
  .reseaux a { display: grid; place-items: center; width: var(--tap); height: var(--tap); border-radius: 50%; background: #e9ebe61a; }
  .reseaux :global(svg) { width: 22px; height: 22px; }
  @media (min-width: 768px) { .grille { grid-template-columns: 1fr 1fr; gap: 72px; } }
</style>
