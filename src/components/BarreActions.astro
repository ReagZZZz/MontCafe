---
// Barre fixe en bas d'écran (mobile uniquement) : les 2 actions clés toujours à portée de pouce
import data from '../data/data.json';
import { liens } from '../lib/liens.js';
import Icone from './Icone.astro';
const { itineraire, appel } = liens(data.commerce);
---
<nav class="barre" aria-label="Actions rapides">
  <a href={appel}><Icone nom="tel" />Appeler</a>
  <a href={itineraire} target="_blank" rel="noopener"><Icone nom="itineraire" />Itinéraire</a>
</nav>

<style>
  .barre {
    position: fixed; inset: auto 0 0 0; z-index: 50;
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: rgb(250 245 239 / .96); backdrop-filter: blur(8px);
    border-top: 1px solid var(--caramel-clair);
  }
  .barre a {
    min-height: 52px; display: flex; align-items: center; justify-content: center; gap: 8px;
    border-radius: 12px; font-weight: 700; text-decoration: none; background: var(--brun); color: var(--creme);
  }
  .barre a:last-child { background: var(--caramel); color: var(--brun-fonce); }
  .barre :global(svg) { width: 20px; height: 20px; }
  @media (min-width: 768px) { .barre { display: none; } }
</style>
