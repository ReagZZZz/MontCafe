---
// Bandeau d'alerte / vacances en haut de page, édité par Laurent dans /admin/
import { annonce } from '../lib/boutique.js';
---
{annonce && (
  <aside class="annonce" role="status">
    <p class="conteneur"><strong>Info</strong> {annonce.texte}</p>
  </aside>
)}

<style>
  .annonce { padding: 12px 0; font-size: .98rem; line-height: 1.4; background: var(--torref); color: var(--brume); }
  .annonce strong { display: inline-block; margin-right: 8px; padding: 1px 9px; border-radius: 999px; font-size: .85rem; background: var(--t1); color: var(--torref); }
</style>
