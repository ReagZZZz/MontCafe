---
// Hero : le nom en très grand, la promesse, les 2 actions,
// puis la baie du Mont dessinée en SVG (aucune image à charger)
// et la bande de torréfaction qui se "torréfie" au chargement.
import Icone from './Icone.astro';
import data from '../data/site.json';
import { liens } from '../lib/liens.js';

const c = data.commerce;
const { itineraire, appel } = liens(c);
// Silhouette stylisée du Mont-Saint-Michel (viewBox 400×160, horizon à y=150)
const mont = 'M96 150 L128 141 L139 124 L154 118 L159 103 L171 99 L174 84 L184 79 L187 63 L195 58 L197 34 L200 6 L203 34 L205 58 L213 63 L216 79 L226 84 L229 99 L241 103 L246 118 L261 124 L272 141 L304 150 Z';
---
<header class="hero">
  <div class="conteneur hero__grille">
    <div class="hero__texte">
      <p class="statut" data-statut></p>
      <h1>
        <span class="hero__nom">{c.nom}</span>
        <span class="hero__metier">{c.activite} à {c.ville}</span>
      </h1>
      <p class="hero__accroche">{c.slogan}</p>
      <p class="hero__sous">{c.sousSlogan}</p>
      <div class="hero__actions">
        <a class="btn btn--plein" href="/commander/"><Icone nom="sac" />Commander à emporter</a>
        <a class="btn btn--contour" href={itineraire} target="_blank" rel="noopener"><Icone nom="itineraire" />Itinéraire</a>
        <a class="btn btn--contour" href={appel}><Icone nom="tel" />Appeler {c.telephoneAffiche}</a>
      </div>
    </div>

    <figure class="hero__baie" aria-hidden="true">
      <!-- "meet" : le dessin n'est jamais rogné (vapeur comprise) ; le ciel et la grève
           débordent du cadre pour remplir toute la largeur, jusqu'au bord de l'écran. -->
      <svg viewBox="0 0 400 230" preserveAspectRatio="xMidYMax meet">
        <defs>
          <linearGradient id="ciel" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="150">
            <stop offset="0" stop-color="#e9ebe6" /><stop offset="1" stop-color="#d8d0c0" />
          </linearGradient>
          <linearGradient id="greve" gradientUnits="userSpaceOnUse" x1="0" y1="150" x2="0" y2="230">
            <stop offset="0" stop-color="#c9c3b3" /><stop offset="1" stop-color="#b9b19e" />
          </linearGradient>
        </defs>
        <rect x="-1200" y="-600" width="2800" height="750" fill="url(#ciel)" />
        <circle cx="300" cy="62" r="20" fill="#f3efe6" />
        <!-- Le Mont est légèrement réduit (82 %, ancré sur sa base) pour laisser de la place à la vapeur -->
        <g transform="translate(36 27) scale(0.82)">
          <path d={mont} fill="#5e7179" />
        </g>
        <!-- Le Mont fume comme une tasse de café chaud -->
        <g class="vapeur" fill="none" stroke="#5e7179" stroke-width="2.2" stroke-linecap="round">
          <path d="M195 29c-5-5 3-9-1-14s3-9-1-13" />
          <path d="M201 27c5-5-3-9 1-14s-3-9 1-12" />
          <path d="M207 29c-5-4 3-8-1-13s3-8 0-11" />
        </g>
        <rect x="-1200" y="150" width="2800" height="80" fill="url(#greve)" />
        <!-- Reflet dans le sable mouillé -->
        <g transform="translate(36 27) scale(0.82)">
          <path d={mont} fill="#5e7179" opacity=".22" transform="translate(0 300) scale(1 -1)" />
        </g>
        <g stroke="#e9ebe6" stroke-width="1.4" stroke-linecap="round" opacity=".8">
          <path d="M20 166h90M160 172h140M40 186h60M250 190h120M90 204h170M10 218h80M300 214h80" />
          <!-- Reflets supplémentaires de part et d'autre, pour les écrans larges -->
          <path d="M430 170h120M470 198h90M420 222h150M600 182h110M640 210h80M720 194h120M-200 176h130M-260 200h90M-150 220h120" />
        </g>
      </svg>
    </figure>
  </div>

  <div class="torrefaction" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
</header>

<style>
  .hero { padding-top: 28px; overflow: hidden; }
  .hero__grille { display: grid; gap: 28px; }
  h1 { margin-top: 18px; }
  .hero__nom {
    display: block;
    font-size: clamp(4.2rem, 23vw, 9.5rem);
    font-variation-settings: "wdth" 75;
    font-weight: 800; letter-spacing: -0.045em; line-height: .86;
  }
  .hero__metier {
    display: block; margin-top: 12px;
    font-size: 1.15rem; font-weight: 500; color: var(--baie);
  }
  .hero__accroche {
    margin-top: 22px; font-size: 1.45rem; line-height: 1.25; font-weight: 600;
    font-variation-settings: "wdth" 85; max-width: 24ch;
  }
  .hero__sous { margin-top: 12px; color: var(--texte-doux); max-width: 40ch; }
  .hero__actions { display: grid; gap: 10px; margin-top: 26px; }

  /* --h : hauteur de l'illustration. Le SVG fait au moins la largeur qu'il faut pour
     occuper toute cette hauteur (ratio 400/230), centré : le Mont garde sa taille
     sur tous les écrans, et le décor remplit l'espace restant jusqu'au bord. */
  .hero__baie { --h: 230px; margin: 0 -20px; height: var(--h); overflow: hidden; }
  .hero__baie svg {
    display: block; height: 100%; width: max(100%, calc(var(--h) * 400 / 230)); max-width: none;
    margin-left: 50%; transform: translateX(-50%); overflow: visible;
  }

  /* Signature : la bande passe du grain vert au grain torréfié, une seule fois au chargement */
  .torrefaction { display: flex; height: 18px; }
  .torrefaction span { flex: 1; transform-origin: left; animation: torrefie .9s cubic-bezier(.2, .7, .2, 1) both; }
  .torrefaction span:nth-child(1) { background: var(--t1); animation-delay: .15s; }
  .torrefaction span:nth-child(2) { background: var(--t2); animation-delay: .3s; }
  .torrefaction span:nth-child(3) { background: var(--t3); animation-delay: .45s; }
  .torrefaction span:nth-child(4) { background: var(--t4); animation-delay: .6s; }
  .torrefaction span:nth-child(5) { background: var(--t5); animation-delay: .75s; }
  @keyframes torrefie { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  @media (min-width: 900px) {
    .hero { padding-top: 56px; }
    .hero__grille { grid-template-columns: 1.1fr 1fr; align-items: end; gap: 48px; }
    .hero__actions { display: flex; flex-wrap: wrap; }
    /* L'image déborde du conteneur jusqu'au bord droit de l'écran */
    .hero__baie { --h: 420px; margin: 0 calc(-20px - max(0px, (100vw - 1080px) / 2)) 0 0; -webkit-mask-image: linear-gradient(90deg, transparent, #000 18%); mask-image: linear-gradient(90deg, transparent, #000 18%); }
  }
  /* Vapeur du Mont : 3 volutes qui montent et s'estompent en boucle, décalées.
     Statiques et discrètes si l'appareil demande moins d'animations. */
  .vapeur path { opacity: .3; transform-box: fill-box; transform-origin: 50% 100%; }
  @media (prefers-reduced-motion: no-preference) {
    .vapeur path { opacity: 0; animation: vapeur 4.2s ease-in-out infinite; }
    .vapeur path:nth-child(2) { animation-delay: 1.4s; }
    .vapeur path:nth-child(3) { animation-delay: 2.8s; }
  }
  @keyframes vapeur {
    0%   { opacity: 0;   transform: translateY(6px) scaleY(.7); }
    35%  { opacity: .45; }
    100% { opacity: 0;   transform: translateY(-10px) scaleY(1.15); }
  }
</style>
