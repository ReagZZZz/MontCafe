---
// Nos cafés : onglets en CSS pur (boutons radio), zéro JavaScript.
// Chaque café affiche son niveau de torréfaction sur l'échelle de la marque.
import data from '../data/site.json';
import { cafes } from '../lib/boutique.js';
import { drapeauPays } from '../lib/drapeaux.js';
import Icone from './Icone.astro';
const titre = 'Nos cafés du moment';
const { intro, categories } = cafes;
const services = data.services;
const prixVisible = (p) => p && p !== 'A_CONFIRMER'; // prix vide = non affiché
const NIVEAUX = ['', 'Très claire', 'Claire', 'Médium', 'Médium foncée', 'Foncée'];
---
<section class="section cafes" id="cafes" aria-labelledby="titre-cafes">
  <div class="conteneur">
    <h2 id="titre-cafes">{titre}</h2>
    <p class="chapeau">{intro}</p>

    <div class="onglets">
      {categories.map((_, i) => (
        <input type="radio" name="cat" id={`cat-${i}`} checked={i === 0} class="onglets__radio" />
      ))}
      <div class="onglets__barre">
        {categories.map((cat, i) => <label for={`cat-${i}`}>{cat.nom}</label>)}
      </div>

      {categories.map((cat, i) => (
        <ul class="liste" data-i={i}>
          {cat.produits.map((p) => {
            const drapeau = drapeauPays(p.nom);
            return (
            <li class="cafe">
              <div class="cafe__tete">
                <h3>{drapeau && <span aria-hidden="true">{drapeau} </span>}{p.nom}</h3>
                {(prixVisible(p.prix) || p.format) && (
                  <p class="cafe__prix">{prixVisible(p.prix) && <strong>{p.prix}</strong>} {p.format}</p>
                )}
              </div>
              {p.origine && <p class="cafe__origine">{p.origine}</p>}
              {p.notes?.length > 0 && (
                <ul class="cafe__notes" aria-label="Notes de dégustation">
                  {p.notes.map((n) => <li>{n}</li>)}
                </ul>
              )}
              {p.torrefaction > 0 && (
                <div class="cafe__torref">
                  <div class="echelle" role="img" aria-label={`Torréfaction ${NIVEAUX[p.torrefaction].toLowerCase()}, ${p.torrefaction} sur 5`}>
                    {[1, 2, 3, 4, 5].map((n) => <i class={n <= p.torrefaction ? 'on' : ''}></i>)}
                  </div>
                  <span>Torréfaction {NIVEAUX[p.torrefaction].toLowerCase()}</span>
                </div>
              )}
            </li>
            );
          })}
        </ul>
      ))}
    </div>

    <ul class="services">
      {services.map((s) => <li><h3>{s.titre}</h3><p>{s.texte}</p></li>)}
    </ul>

    <a class="btn btn--plein commander-cta" href="/commander/"><Icone nom="sac" />Commander à emporter</a>
  </div>
</section>

<style>
  .cafes { background: var(--greve); }
  .onglets { margin-top: 32px; }
  .onglets__radio { position: absolute; opacity: 0; pointer-events: none; }
  .onglets__barre { display: flex; gap: 6px; border-bottom: 2px solid var(--torref); }
  .onglets__barre label {
    min-height: var(--tap); padding: 0 18px; display: flex; align-items: center;
    font-weight: 600; cursor: pointer; border-radius: 6px 6px 0 0; user-select: none;
  }

  .liste { list-style: none; padding: 0; margin: 0; display: none; }
  .cafe { padding: 22px 0; border-bottom: 1px solid #33231c26; }
  .cafe__tete { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .cafe h3 { font-size: 1.75rem; font-variation-settings: "wdth" 80; letter-spacing: -0.01em; }
  .cafe__prix { white-space: nowrap; color: var(--texte-doux); }
  .cafe__prix strong { color: var(--torref); font-size: 1.15rem; }
  .cafe__origine { color: var(--baie); font-weight: 500; margin-top: 2px; }
  .cafe__notes { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .cafe__notes li { padding: 3px 11px; border-radius: 999px; background: var(--brume); font-size: .92rem; }
  .cafe__torref { display: grid; grid-template-columns: 120px auto; align-items: center; gap: 12px; margin-top: 14px; font-size: .9rem; color: var(--texte-doux); }

  /* Onglet actif + liste visible (jusqu'à 6 catégories) */
  #cat-0:checked ~ .liste[data-i="0"], #cat-1:checked ~ .liste[data-i="1"],
  #cat-2:checked ~ .liste[data-i="2"], #cat-3:checked ~ .liste[data-i="3"],
  #cat-4:checked ~ .liste[data-i="4"], #cat-5:checked ~ .liste[data-i="5"] { display: block; }
  #cat-0:checked ~ .onglets__barre label[for="cat-0"], #cat-1:checked ~ .onglets__barre label[for="cat-1"],
  #cat-2:checked ~ .onglets__barre label[for="cat-2"], #cat-3:checked ~ .onglets__barre label[for="cat-3"],
  #cat-4:checked ~ .onglets__barre label[for="cat-4"], #cat-5:checked ~ .onglets__barre label[for="cat-5"] {
    background: var(--torref); color: var(--brume);
  }
  .onglets__radio:focus-visible ~ .onglets__barre { outline: 3px solid var(--baie); outline-offset: 4px; }

  .services { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 12px; }
  .services li { background: var(--torref); color: var(--brume); padding: 20px 22px; border-radius: 6px; }
  .services h3 { font-size: 1.2rem; color: var(--t2); }
  .services p { margin-top: 4px; opacity: .85; }

  .commander-cta { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; margin-top: 24px; }
  .commander-cta :global(svg) { width: 20px; height: 20px; }
  @media (min-width: 768px) { .commander-cta { width: fit-content; margin-left: auto; margin-right: auto; } }

  @media (min-width: 768px) {
    #cat-0:checked ~ .liste[data-i="0"], #cat-1:checked ~ .liste[data-i="1"],
    #cat-2:checked ~ .liste[data-i="2"], #cat-3:checked ~ .liste[data-i="3"],
    #cat-4:checked ~ .liste[data-i="4"], #cat-5:checked ~ .liste[data-i="5"] {
      display: grid; grid-template-columns: repeat(3, 1fr); column-gap: 32px;
    }
    .services { grid-template-columns: 1fr 1fr; }
  }
</style>
