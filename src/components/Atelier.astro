---
// L'atelier : les 4 étapes, du grain vert à la tasse.
// C'est une vraie séquence, d'où la numérotation ; chaque pastille
// prend la couleur de torréfaction correspondant à l'étape.
import data from '../data/data.json';
const { titre, etapes } = data.atelier;
const couleurs = ['var(--t1)', 'var(--t2)', 'var(--t4)', 'var(--t5)'];
---
<section class="section atelier" aria-labelledby="titre-atelier">
  <div class="conteneur">
    <h2 id="titre-atelier">{titre}</h2>
    <ol class="etapes">
      {etapes.map((e, i) => (
        <li style={`--c:${couleurs[i] ?? 'var(--t5)'}`}>
          <span class="pastille">{i + 1}</span>
          <div>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .etapes { list-style: none; padding: 0; margin: 36px 0 0; position: relative; }
  /* Fil vertical qui relie les étapes */
  .etapes::before {
    content: ""; position: absolute; left: 21px; top: 22px; bottom: 22px; width: 2px;
    background: linear-gradient(var(--t1), var(--t5));
  }
  .etapes li { position: relative; display: grid; grid-template-columns: 44px 1fr; gap: 18px; padding-bottom: 28px; }
  .etapes li:last-child { padding-bottom: 0; }
  .pastille {
    width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center;
    background: var(--c); color: var(--brume); font-weight: 700; font-size: 1.1rem;
    box-shadow: 0 0 0 5px var(--brume);
  }
  .etapes li:first-child .pastille { color: var(--torref); }
  h3 { font-size: 1.3rem; padding-top: 9px; font-variation-settings: "wdth" 85; }
  .etapes p { color: var(--texte-doux); margin-top: 4px; max-width: 42ch; }

  @media (min-width: 900px) {
    .etapes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
    .etapes::before { left: 22px; right: 22px; top: 21px; bottom: auto; width: auto; height: 2px; background: linear-gradient(90deg, var(--t1), var(--t5)); }
    .etapes li { grid-template-columns: 1fr; gap: 14px; padding: 0; }
    h3 { padding-top: 0; }
  }
</style>
