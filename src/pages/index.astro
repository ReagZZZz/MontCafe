---
// Page d'accueil (one-page) : Hero → Avis → Portrait → Atelier (fournée) → Bandeau de notes → Nos cafés → Infos pratiques → Pied de page
import Base from '../layouts/Base.astro';
import Schema from '../components/Schema.astro';
import Annonce from '../components/Annonce.astro';
import Hero from '../components/Hero.astro';
import Portrait from '../components/Portrait.astro';
import Atelier from '../components/Atelier.astro';
import Bandeau from '../components/Bandeau.astro';
import Apparitions from '../components/Apparitions.astro';
import Avis from '../components/Avis.astro';
import Carte from '../components/Carte.astro';
import Infos from '../components/Infos.astro';
import Footer from '../components/Footer.astro';
import BarreActions from '../components/BarreActions.astro';
import StatutOuverture from '../components/StatutOuverture.astro';
---
<Base>
  <Schema slot="head" />
  <Annonce />
  <Hero />
  <Avis />
  <Portrait />
  <main>
    <Atelier />
    <Bandeau />
    <Carte />
    <Infos />
  </main>
  <Footer />
  <BarreActions />
  <StatutOuverture />
  <Apparitions />
</Base>
