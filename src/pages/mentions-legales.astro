---
// Mentions légales (obligatoires – loi LCEN art. 6). Données dans data.json > mentionsLegales
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import data from '../data/data.json';
const m = data.mentionsLegales;
const c = data.commerce;
const ok = (v) => v && !String(v).startsWith('A_CONFIRMER');
---
<Base titre={`Mentions légales – ${c.nom}`} description={`Mentions légales du site ${c.nom}, ${c.ville}.`} noindex>
  <main class="conteneur legal">
    <p><a href={import.meta.env.BASE_URL}>← Retour à l'accueil</a></p>
    <h1>Mentions légales</h1>

    <h2>Éditeur du site</h2>
    <p>
      {m.raisonSociale}, {m.formeJuridique} au capital de {m.capital}<br />
      Siège social : {m.siege}<br />
      {m.rcs} · SIRET {m.siret}<br />
      {ok(m.tvaIntracom) && <>TVA intracommunautaire : {m.tvaIntracom}<br /></>}
      Téléphone : <a href={`tel:${c.telephone}`}>{c.telephoneAffiche}</a>
      {ok(c.email) && <><br />E-mail : <a href={`mailto:${c.email}`}>{c.email}</a></>}
    </p>
    <p>Directeur de la publication : {m.directeurPublication}</p>

    <h2>Hébergement</h2>
    <p>{m.hebergeur.nom}{ok(m.hebergeur.adresse) && <> – {m.hebergeur.adresse}</>}<br />
      <a href={m.hebergeur.site} rel="noopener">{m.hebergeur.site}</a></p>

    {ok(m.realisation) && (<><h2>Conception</h2><p>{m.realisation}</p></>)}

    <h2>Propriété intellectuelle</h2>
    <p>L'ensemble des contenus de ce site (textes, photos, logo) est la propriété de {m.raisonSociale}, sauf mention contraire. Toute reproduction sans autorisation est interdite.</p>

    <h2>Données personnelles et cookies</h2>
    <p>Ce site ne dépose aucun cookie et ne collecte aucune donnée personnelle. La carte Google Maps n'est chargée que si vous cliquez sur « Afficher la carte » ; Google peut alors déposer ses propres cookies, conformément à sa politique de confidentialité.</p>
  </main>
  <Footer />
</Base>

<style>
  .legal { padding-top: 32px; padding-bottom: 48px; max-width: 720px; }
  .legal h1 { font-size: 2.2rem; margin-top: .6em; }
  .legal h2 { font-size: 1.3rem; margin-top: 1.6em; }
  .legal a { color: var(--torref); font-weight: 600; }
  .legal h1 { font-variation-settings: "wdth" 80; }
  .legal p { margin-top: .8em; }
</style>
